# Shared dev default — public Kroki instance.
# Override locally with .env.local (which is gitignored).
VITE_KROKI_ENDPOINT=https://kroki.io

# Browser tab title and in-app header label. Defaults to "Kroki Editor".
# VITE_PAGE_TITLE=Kroki Editor

# Endpoint for rendering the Examples gallery thumbnails. Examples cover every Kroki
# type, so point this at a full-featured instance (e.g. kroki.io) if your main
# endpoint doesn't enable every companion service. Falls back to VITE_KROKI_ENDPOINT.
# VITE_EXAMPLE_KROKI_ENDPOINT=https://kroki.io

# Render Mermaid diagrams in the browser (lazy-loaded) instead of via Kroki.
# Default off. Set to true if your Kroki has no Mermaid companion service.
# VITE_MERMAID_CLIENT_SIDE=true
